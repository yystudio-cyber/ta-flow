{
  "manifest_version": 3,
  "name": "飞书需求 → 表格自动汇总",
  "version": "1.0.0",
  "description": "在 TA 日常 Chrome 里读取飞书招聘需求列表，提取新增需求，通过本地桥写入桌面 Excel。",
  "minimum_chrome_version": "102",
  "key": "",
  "action": {
    "default_title": "飞书需求 → 表格汇总",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/hire/*",
        "https://*.larksuite.com/hire/*"
      ],
      "js": ["content.bundle.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
