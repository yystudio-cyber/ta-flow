{
  "$comment": [
    "工作流配置模板。复制为 config/workflow.json 后修改。",
    "这个文件把平台和你自己的招聘平台/台账/数据目录接起来——仓库里不带任何真实账号或业务数据。"
  ],

  "workspace": {
    "$path_hint": "你的本地数据根目录；留空则用平台默认的 userData 目录",
    "dataDir": ""
  },

  "platforms": {
    "enabled": ["boss"],
    "boss": {
      "entryUrl": "https://www.zhipin.com/web/boss/index",
      "searchUrl": "https://www.zhipin.com/web/boss/recommend",
      "profileDir": "",
      "cdpPort": 9222
    },
    "liepin": {
      "enabled": false,
      "entryUrl": "https://lpt.liepin.com/search",
      "profileDir": "",
      "cdpPort": 9333
    }
  },

  "scoring": {
    "highThreshold": 75,
    "lowThreshold": 60,
    "minCoverageForHigh": 60,
    "weightTemplate": "default"
  },

  "risk": {
    "greetYellow": 13,
    "greetRed": 20,
    "browseYellow": 210,
    "browseRed": 300,
    "nightStartHour": 22,
    "nightEndHour": 7,
    "autoPauseOnDanger": true
  },

  "feishu": {
    "$note": "飞书招聘租户。这里填你自己的租户子域，例如 mycorp 表示 mycorp.feishu.cn。",
    "tenantSubdomain": "example",
    "requirementsListPath": "/hire/job/requirement/list",
    "jobsListPath": "/hire/job/list",
    "approvalRequired": true
  },

  "excel": {
    "$note": "飞书需求汇总写入的 Excel 台账。列名用来做字段映射，换成你自己表的表头即可。",
    "ledgerPath": "",
    "sheetName": "Sheet1",
    "columnMap": {
      "0级部门": "level0Department",
      "1级部门": "level1Department",
      "职位名称": "jobTitle",
      "需求编号": "reqNo",
      "招聘数量": "headcount",
      "工作地": "location"
    }
  },

  "corpus": {
    "$note": "评分标定用的简历语料目录：把你自己匿名化后的简历放进去，npm run score:eval 会读它。",
    "resumeDir": "./corpus",
    "jdConfig": "./config/jd-config.json"
  }
}
